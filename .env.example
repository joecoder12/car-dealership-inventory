# Copy to .env (or run `npm run setup:env`, which also generates JWT_SECRET).
# Never commit .env. All values below are placeholders or local-only defaults.

# --- Backend -----------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Local development database. scripts/db.sh and docker-compose.yml both create a
# cluster that listens on 127.0.0.1 only and trusts local connections, so no
# password is needed. Use a real password for any shared or deployed database.
DATABASE_URL=postgresql://postgres@localhost:5432/car_dealership

# Used by the backend integration tests. The name MUST end in _test; the test
# harness refuses to truncate any other database.
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/car_dealership_test

# Used by Playwright end-to-end tests (name must end in _e2e).
E2E_DATABASE_URL=postgresql://postgres@localhost:5432/car_dealership_e2e

# At least 32 random characters, e.g. `openssl rand -base64 48`.
# The server refuses to start while this placeholder is still present.
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN_MINUTES=60

# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5180

# Requests per 15 minutes per IP on /api/auth/login and /api/auth/register.
AUTH_RATE_LIMIT_MAX=20

# --- Admin bootstrap (only read by `npm run admin:create`) -------------------
# Leave blank here; pass them on the command line instead (see README).
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Frontend ----------------------------------------------------------------
# Where the Vite dev server proxies /api requests.
VITE_API_PROXY_TARGET=http://localhost:4000
